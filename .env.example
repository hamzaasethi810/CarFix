# Copy to .env and fill in. Never commit .env.
# Everything here is server-only. No NEXT_PUBLIC_ variable should ever hold a secret.

# ---- Database ----
# Local dev: a dedicated database and a non-superuser role.
# Production (free): a Neon project connection string (https://neon.tech).
# Runtime role: SELECT/INSERT/UPDATE/DELETE only. Cannot DROP or TRUNCATE.
# Postgres. If the URL carries sslmode=require, prefer or verify-ca, the app
# upgrades it to verify-full at connect time (see lib/db-url.ts) — those modes
# stop verifying certificates in the next major pg release, and a dependency
# bump should not quietly downgrade a production connection.
DATABASE_URL="postgresql://carfix_app:REPLACE_ME@localhost:5432/carfix_dev"

# Schema owner, used only by migrations. Keep this out of the app's environment
# in production. See prisma/roles.sql for how the split is created.
# NOT covered by the verify-full upgrade above: it's read straight into the
# Prisma CLI's datasource url (see prisma.config.ts), which never calls our
# code, so withStrictSsl cannot run on it. Give it verify-full explicitly if
# its sslmode would otherwise need upgrading.
MIGRATE_DATABASE_URL="postgresql://carfix_migrate:REPLACE_ME@localhost:5432/carfix_dev"

# ---- Auth ----
# Generate with: openssl rand -base64 32
AUTH_SECRET="REPLACE_ME_WITH_A_32_BYTE_RANDOM_STRING"
# Only needed if the deployment URL cannot be inferred.
# AUTH_URL="https://your-app.vercel.app"

# ---- Object storage (S3-compatible) ----
# Free tier: Cloudflare R2. Works unchanged against MinIO or AWS S3 when self-hosting.
# BOTH buckets must be PRIVATE. Receipts especially must never be public.
S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_ACCESS_KEY_ID="REPLACE_ME"
S3_SECRET_ACCESS_KEY="REPLACE_ME"
S3_BUCKET_PHOTOS="carfix-photos"
S3_BUCKET_RECEIPTS="carfix-receipts"

# ---- Rate limiting (optional in dev, required in production) ----
# Free tier: Upstash Redis. Without these, rate limiting is disabled locally.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Number of reverse proxies YOUR infrastructure runs in front of the app.
# Rate limiting derives the client IP from X-Forwarded-For, which the client
# can forge; only the last N entries (added by your own proxies) are trusted.
# Set to the exact number of hops: 1 for a single proxy/PaaS (Vercel, Fly,
# nginx) — the default; 0 when nothing proxies the app, which makes it ignore
# X-Forwarded-For entirely. Too high reads client-controlled values as the IP,
# so err low. Wrong here means auth rate limits can be bypassed.
TRUSTED_PROXY_HOPS="1"

# Tests truncate tables — must be a DIFFERENT database from DATABASE_URL.
TEST_DATABASE_URL="postgresql://carfix_app:REPLACE_ME@localhost:5432/carfix_test"

# ---- Stripe (shop subscriptions) ----
# Card details are entered on Stripe's own Checkout page and never touch this
# server, which keeps the deployment in PCI SAQ-A scope. Only these keys live
# here; no card data is stored anywhere in this application.
STRIPE_SECRET_KEY=""
# From `stripe listen` locally, or the endpoint's signing secret in the dashboard.
STRIPE_WEBHOOK_SECRET=""
# The recurring price for the shop subscription.
STRIPE_PRICE_ID=""
# Absolute origin, used to build Checkout return URLs.
APP_URL="http://localhost:3000"

# ---- Email (password resets) ----
# Resend's free tier covers 3,000 messages a month. Without these, reset links
# are written to the server log instead of being sent — fine locally, and
# logged as an error in production so it cannot fail silently.
RESEND_API_KEY=""
# Must be a domain verified in Resend, e.g. "CarFix <noreply@yourdomain.com>"
EMAIL_FROM=""

# ---- Map tiles ----
# Optional. The site works without it — the map falls back to a keyless dark
# style. Set this for MapTiler's dark basemap instead. Domain-restricted, not
# secret; NEXT_PUBLIC_ because the browser makes the tile requests.
MAPTILER_KEY=""

# ---- Social sign-in (optional; buttons appear only when configured) ----
# Google: create an OAuth client at console.cloud.google.com and add the
# redirect URI https://YOUR_DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Apple ("Sign in with Apple"). Requires an Apple Developer account. The client
# secret is a JWT the app mints at runtime from these four values, so it never
# expires on you. Apple does NOT allow localhost — it only works on the live
# HTTPS domain, whose Service ID return URL must be
# https://YOUR_DOMAIN/api/auth/callback/apple
# APPLE_CLIENT_ID is the Service ID (e.g. com.wrenchrates.web), NOT the App ID.
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
# The .p8 key contents. In a dashboard paste it as one line with \n for breaks:
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIG...\n-----END PRIVATE KEY-----"
APPLE_PRIVATE_KEY=""
