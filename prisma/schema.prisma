// Prisma schema for CarFix.
// See prisma.config.ts for datasource URL loading (Prisma 7 requires explicit env loading).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum Role {
  USER
  ADMIN
}

enum PhotoSlot {
  FRONT
  BACK
  INTERIOR
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum VerificationMethod {
  NONE
  RECEIPT
}

enum ReportTargetType {
  EXPERIENCE
  MECHANIC
  PROFILE
}

enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

// Where a shop record came from. OSM rows are ingested on demand from
// OpenStreetMap so the directory covers anywhere people search, rather than
// only places that were seeded by hand.
enum MechanicSource {
  SEED
  OSM
  USER
}

// ---------- Auth (Auth.js / NextAuth database session strategy) ----------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  profile             Profile?
  vehicles            Vehicle[]
  experiences         MechanicExperience[]
  verifiedExperiences MechanicExperience[] @relation("VerifiedBy")
  reports             Report[]
  auditLogs           AuditLog[]
  accounts            Account[]
  sessions            Session[]

  @@index([deletedAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Profile ----------

model Profile {
  id              String  @id @default(cuid())
  userId          String  @unique
  username        String  @unique
  displayName     String
  bio             String?
  photoKey        String?
  generalLocation String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- Vehicle taxonomy ----------

model Make {
  id   String @id @default(cuid())
  name String @unique

  models   Model[]
  vehicles Vehicle[]
}

model Model {
  id     String @id @default(cuid())
  makeId String
  name   String

  make        Make         @relation(fields: [makeId], references: [id], onDelete: Restrict)
  generations Generation[]
  vehicles    Vehicle[]

  @@unique([makeId, name])
}

model Platform {
  id   String @id @default(cuid())
  name String @unique

  generations Generation[]
}

model Generation {
  id         String  @id @default(cuid())
  modelId    String
  platformId String?
  code       String
  yearStart  Int
  yearEnd    Int?

  model    Model     @relation(fields: [modelId], references: [id], onDelete: Restrict)
  platform Platform? @relation(fields: [platformId], references: [id], onDelete: SetNull)
  trims    Trim[]
  vehicles Vehicle[]

  @@unique([modelId, code])
  // Resolving a model year to its generation is the hottest taxonomy query.
  @@index([modelId, yearStart, yearEnd])
  @@index([platformId])
}

model Trim {
  id           String @id @default(cuid())
  generationId String
  name         String

  generation Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)
  vehicles   Vehicle[]

  @@unique([generationId, name])
}

model Engine {
  id   String @id @default(cuid())
  name String @unique

  vehicles Vehicle[]
}

model Drivetrain {
  id   String @id @default(cuid())
  name String @unique

  vehicles Vehicle[]
}

// ---------- Vehicles ----------

model Vehicle {
  id           String    @id @default(cuid())
  ownerId      String
  makeId       String
  modelId      String
  generationId String
  year         Int
  trimId       String?
  engineId     String?
  drivetrainId String?
  mileage      Int?
  nickname     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  owner       User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  make        Make                 @relation(fields: [makeId], references: [id], onDelete: Restrict)
  model       Model                @relation(fields: [modelId], references: [id], onDelete: Restrict)
  generation  Generation           @relation(fields: [generationId], references: [id], onDelete: Restrict)
  trim        Trim?                @relation(fields: [trimId], references: [id], onDelete: SetNull)
  engine      Engine?              @relation(fields: [engineId], references: [id], onDelete: SetNull)
  drivetrain  Drivetrain?          @relation(fields: [drivetrainId], references: [id], onDelete: SetNull)
  photos      VehiclePhoto[]
  experiences MechanicExperience[]

  @@index([ownerId, deletedAt])
  @@index([generationId])
}

model VehiclePhoto {
  id         String    @id @default(cuid())
  vehicleId  String
  slot       PhotoSlot
  storageKey String
  updatedAt  DateTime  @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, slot])
}

// ---------- Mechanics & services ----------

model Mechanic {
  id          String         @id @default(cuid())
  name        String
  description String?
  address     String
  city        String
  state       String
  zip         String
  lat         Float
  lng         Float
  phone       String?
  website     String?
  hours       Json?
  source      MechanicSource @default(SEED)
  /// Upstream identifier, e.g. "node/123456" for OpenStreetMap.
  sourceRef   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  specialties MechanicSpecialty[]
  experiences MechanicExperience[]

  // Re-ingesting the same OSM element updates the row instead of duplicating it.
  @@unique([source, sourceRef])
  @@index([city, state])
  // Supports the bounding-box prefilter that runs before distance is computed.
  @@index([lat, lng])
  @@index([deletedAt])
}

model Service {
  id   String @id @default(cuid())
  name String @unique

  mechanics   MechanicSpecialty[]
  experiences MechanicExperience[]
}

model MechanicSpecialty {
  mechanicId String
  serviceId  String

  mechanic Mechanic @relation(fields: [mechanicId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([mechanicId, serviceId])
}

// ---------- Experiences ----------

model MechanicExperience {
  id         String @id @default(cuid())
  userId     String
  vehicleId  String
  mechanicId String
  serviceId  String

  totalPrice       Float
  partsCost        Float?
  laborCost        Float?
  serviceDate      DateTime
  mileageAtService Int

  overallRating       Int
  qualityRating       Int
  priceRating         Int
  communicationRating Int
  turnaroundRating    Int
  knowledgeRating     Int
  wouldRecommend      Boolean
  wouldReturn         Boolean
  reviewText          String?

  verificationStatus VerificationStatus @default(UNVERIFIED)
  verificationMethod VerificationMethod @default(NONE)
  verifiedAt         DateTime?
  verifiedById       String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  mechanic   Mechanic @relation(fields: [mechanicId], references: [id], onDelete: Cascade)
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  verifiedBy User?    @relation("VerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  receipt    Receipt?
  reports    Report[]

  @@index([mechanicId, serviceId])
  @@index([vehicleId])
  @@index([verificationStatus])
}

// Receipt rows are metadata only. The uploaded file lives in a private bucket
// under a random key and is deleted the moment an admin approves or rejects
// the verification request — storageKey is nulled out at that point.
model Receipt {
  id           String    @id @default(cuid())
  experienceId String    @unique
  storageKey   String?
  uploadedAt   DateTime  @default(now())
  deletedAt    DateTime?

  experience MechanicExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
}

// ---------- Moderation ----------

model Report {
  id           String           @id @default(cuid())
  reporterId   String
  targetType   ReportTargetType
  experienceId String?
  reason       String
  status       ReportStatus     @default(OPEN)
  createdAt    DateTime         @default(now())

  reporter   User                @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  experience MechanicExperience? @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([status])
}

/*
  Records which areas have already been pulled from OpenStreetMap, so a popular
  search does not hit the shared Overpass API on every request. The centre is
  rounded to a coarse grid, and a stored entry satisfies any request with an
  equal or smaller radius.
*/
model GeoCoverage {
  id          String   @id @default(cuid())
  cellLat     Float
  cellLng     Float
  radiusMiles Int
  shopCount   Int      @default(0)
  fetchedAt   DateTime @default(now())

  @@unique([cellLat, cellLng])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
}
