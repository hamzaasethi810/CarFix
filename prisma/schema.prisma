// Prisma schema for CarFix.
// See prisma.config.ts for datasource URL loading (Prisma 7 requires explicit env loading).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum Role {
  USER
  /*
    Can work the verification and claim queues — which means minting the
    short-lived links that reveal receipts and business documents — and
    nothing else. No role management, no moderation.

    It exists so document review can be delegated without handing out the
    ability to grant administrator rights.
  */
  REVIEWER
  ADMIN
}


enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum VerificationMethod {
  NONE
  RECEIPT
}

enum ReportTargetType {
  EXPERIENCE
  MECHANIC
  PROFILE
}

enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

enum ShopClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

// Mirrors Stripe's subscription lifecycle. Entitlement is read from here, never
// from anything the browser sends.
enum SubscriptionStatus {
  NONE
  ACTIVE
  PAST_DUE
  CANCELED
}

/*
  How much confidence there is that a listing is a real business.

  A listing added by a member of the public starts PROVISIONAL: visible, but
  labelled, and barred from the gold badge. It becomes CONFIRMED when enough
  independent people report work there, or a reviewer approves it, or its
  owner claims it with a trading document. Anything imported from
  OpenStreetMap starts CONFIRMED, because it has already been through that
  project's own editing and review.
*/
enum ListingStatus {
  PROVISIONAL
  CONFIRMED
  REJECTED
}

// Where a shop record came from. OSM rows are ingested on demand from
// OpenStreetMap so the directory covers anywhere people search, rather than
// only places that were seeded by hand.
enum MechanicSource {
  SEED
  OSM
  USER
}

// ---------- Auth (Auth.js / NextAuth database session strategy) ----------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  /*
    Second factor. The secret is encrypted at rest with AES-256-GCM, so a
    database dump alone cannot be used to generate valid codes.
  */
  totpSecret     String?
  totpEnabledAt  DateTime?
  /// Rejects a code that has already been used, closing the replay window.
  totpLastUsedAt DateTime?

  /*
    Any session issued before this moment is refused.

    Granting a role bumps it, which signs the account out everywhere. That is
    what makes the promotion take effect as a fresh login rather than silently
    upgrading a tab someone already had open — and it is the point at which we
    can insist on a second factor.
  */
  sessionsValidFrom DateTime?

  backupCodes         BackupCode[]
  passwordResets      PasswordResetToken[]
  profile             Profile?
  vehicles            Vehicle[]
  experiences         MechanicExperience[]
  verifiedExperiences MechanicExperience[] @relation("VerifiedBy")
  reports             Report[]
  auditLogs           AuditLog[]
  accounts            Account[]
  sessions            Session[]
  claimedShops        Mechanic[]  @relation("ClaimedShops")
  helpfulVotes        HelpfulVote[]
  shopReplies         ShopReply[]
  savedSearches       SavedSearch[]
  submittedClaims     ShopClaim[] @relation("SubmittedClaims")
  submittedShops      Mechanic[]  @relation("SubmittedShops")
  decidedClaims       ShopClaim[] @relation("DecidedClaims")

  @@index([deletedAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/*
  Single-use recovery codes for someone who loses their authenticator. Stored
  as hashes: a database dump reveals nothing usable, exactly like a password.
*/
/*
  A single-use password reset token.

  Stored hashed, exactly like a password: whoever holds the raw token can take
  over the account, so a database dump must not hand that over. The row is kept
  after use so a replayed link fails loudly rather than looking untouched.
*/
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  /// Recorded to make abuse investigable, not to identify anyone.
  requestIp String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
}

model BackupCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Profile ----------

model Profile {
  id              String  @id @default(cuid())
  userId          String  @unique
  username        String  @unique
  displayName     String
  bio             String?
  photoKey        String?
  generalLocation String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- Vehicle taxonomy ----------

model Make {
  id   String @id @default(cuid())
  name String @unique

  models   Model[]
  vehicles Vehicle[]
}

model Model {
  id     String @id @default(cuid())
  makeId String
  name   String

  make        Make         @relation(fields: [makeId], references: [id], onDelete: Restrict)
  generations Generation[]
  vehicles    Vehicle[]

  @@unique([makeId, name])
}

model Platform {
  id   String @id @default(cuid())
  name String @unique

  generations Generation[]
}

model Generation {
  id         String  @id @default(cuid())
  modelId    String
  platformId String?
  code       String
  yearStart  Int
  yearEnd    Int?

  model    Model     @relation(fields: [modelId], references: [id], onDelete: Restrict)
  platform Platform? @relation(fields: [platformId], references: [id], onDelete: SetNull)
  trims    Trim[]
  vehicles Vehicle[]

  @@unique([modelId, code])
  // Resolving a model year to its generation is the hottest taxonomy query.
  @@index([modelId, yearStart, yearEnd])
  @@index([platformId])
}

model Trim {
  id           String @id @default(cuid())
  generationId String
  name         String

  generation Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)
  vehicles   Vehicle[]

  @@unique([generationId, name])
}

model Engine {
  id   String @id @default(cuid())
  name String @unique

  vehicles Vehicle[]
}

model Drivetrain {
  id   String @id @default(cuid())
  name String @unique

  vehicles Vehicle[]
}

// ---------- Vehicles ----------

model Vehicle {
  id           String    @id @default(cuid())
  ownerId      String
  makeId       String
  modelId      String
  generationId String
  year         Int
  trimId       String?
  engineId     String?
  drivetrainId String?
  mileage      Int?
  nickname     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  owner       User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  make        Make                 @relation(fields: [makeId], references: [id], onDelete: Restrict)
  model       Model                @relation(fields: [modelId], references: [id], onDelete: Restrict)
  generation  Generation           @relation(fields: [generationId], references: [id], onDelete: Restrict)
  trim        Trim?                @relation(fields: [trimId], references: [id], onDelete: SetNull)
  engine      Engine?              @relation(fields: [engineId], references: [id], onDelete: SetNull)
  drivetrain  Drivetrain?          @relation(fields: [drivetrainId], references: [id], onDelete: SetNull)
  experiences MechanicExperience[]

  @@index([ownerId, deletedAt])
  @@index([generationId])
}


// ---------- Mechanics & services ----------

model Mechanic {
  id          String         @id @default(cuid())
  name        String
  description String?
  address     String
  city        String
  /** Empty outside the United States, where the concept does not apply. */
  state       String
  /*
    ISO 3166-1 alpha-2. Defaults to US because every listing that existed
    before this column was added came from a US-only ingest, so backfilling
    them to anything else would be inventing data.
  */
  country     String  @default("US")
  zip         String
  lat         Float
  lng         Float
  phone       String?
  website     String?
  hours       Json?
  source        MechanicSource @default(SEED)
  listingStatus ListingStatus  @default(CONFIRMED)
  /// Who added it, when a member of the public did.
  submittedById String?
  submittedAt   DateTime?
  /// Upstream identifier, e.g. "node/123456" for OpenStreetMap.
  sourceRef   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  /// Set once a claim is approved. Only this user may manage the shop.
  claimedById String?
  claimedAt   DateTime?

  subscriptionStatus SubscriptionStatus @default(NONE)
  /// Stripe identifiers. No card data is ever stored here or anywhere else.
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  subscriptionEndsAt   DateTime?

  claimedBy   User?                @relation("ClaimedShops", fields: [claimedById], references: [id], onDelete: SetNull)
  submittedBy User?                @relation("SubmittedShops", fields: [submittedById], references: [id], onDelete: SetNull)
  claims      ShopClaim[]
  replies     ShopReply[]
  servicePrices ShopServicePrice[]
  specialties MechanicSpecialty[]
  experiences MechanicExperience[]

  @@index([subscriptionStatus])
  @@index([listingStatus])
  // Re-ingesting the same OSM element updates the row instead of duplicating it.
  @@unique([source, sourceRef])
  @@index([city, state])
  // Supports the bounding-box prefilter that runs before distance is computed.
  @@index([lat, lng])
  @@index([deletedAt])
}

model Service {
  id   String @id @default(cuid())
  name String @unique

  mechanics   MechanicSpecialty[]
  experiences MechanicExperience[]
  shopPrices  ShopServicePrice[]

  /// Groups services in the picker: "Maintenance", "Modification", and so on.
  category    String @default("Other")

  @@index([category])
}

model MechanicSpecialty {
  mechanicId String
  serviceId  String

  mechanic Mechanic @relation(fields: [mechanicId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([mechanicId, serviceId])
}

// ---------- Experiences ----------

model MechanicExperience {
  id         String @id @default(cuid())
  userId     String
  vehicleId  String
  mechanicId String
  serviceId  String

  totalPrice       Float
  partsCost        Float?
  laborCost        Float?
  serviceDate      DateTime
  mileageAtService Int

  overallRating       Int
  qualityRating       Int
  priceRating         Int
  communicationRating Int
  turnaroundRating    Int
  knowledgeRating     Int
  wouldRecommend      Boolean
  wouldReturn         Boolean
  reviewText          String?

  verificationStatus VerificationStatus @default(UNVERIFIED)
  verificationMethod VerificationMethod @default(NONE)
  verifiedAt         DateTime?
  verifiedById       String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  mechanic   Mechanic @relation(fields: [mechanicId], references: [id], onDelete: Cascade)
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  verifiedBy User?    @relation("VerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  receipt      Receipt?
  reports      Report[]
  helpfulVotes HelpfulVote[]
  shopReply    ShopReply?
  workPhotos   WorkPhoto[]

  @@index([mechanicId, serviceId])
  @@index([vehicleId])
  @@index([verificationStatus])
}

// Receipt rows are metadata only. The uploaded file lives in a private bucket
// under a random key and is deleted the moment an admin approves or rejects
// the verification request — storageKey is nulled out at that point.
model Receipt {
  id           String    @id @default(cuid())
  experienceId String    @unique
  storageKey   String?
  uploadedAt   DateTime  @default(now())
  deletedAt    DateTime?

  experience MechanicExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
}

// ---------- Moderation ----------

model Report {
  id           String           @id @default(cuid())
  reporterId   String
  targetType   ReportTargetType
  experienceId String?
  reason       String
  status       ReportStatus     @default(OPEN)
  createdAt    DateTime         @default(now())

  reporter   User                @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  experience MechanicExperience? @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([status])
}

/*
  Records which areas have already been pulled from OpenStreetMap, so a popular
  search does not hit the shared Overpass API on every request. The centre is
  rounded to a coarse grid, and a stored entry satisfies any request with an
  equal or smaller radius.
*/
model GeoCoverage {
  id          String   @id @default(cuid())
  cellLat     Float
  cellLng     Float
  radiusMiles Int
  shopCount   Int      @default(0)
  fetchedAt   DateTime @default(now())

  @@unique([cellLat, cellLng])
}

/*
  A request to manage a shop listing, backed by a document proving the person
  runs the business. The document lives in private storage under a random key
  and is destroyed the moment a decision is made — exactly like a receipt.
*/
model ShopClaim {
  id         String          @id @default(cuid())
  userId     String
  mechanicId String
  status     ShopClaimStatus @default(PENDING)
  /// Null once the decision has been made and the file deleted.
  documentKey String?
  businessName String
  contactPhone String?
  note        String?
  submittedAt DateTime        @default(now())
  decidedAt   DateTime?
  decidedById String?

  user      User     @relation("SubmittedClaims", fields: [userId], references: [id], onDelete: Cascade)
  mechanic  Mechanic @relation(fields: [mechanicId], references: [id], onDelete: Cascade)
  decidedBy User?    @relation("DecidedClaims", fields: [decidedById], references: [id], onDelete: SetNull)

  // One open claim per person per shop.
  @@unique([userId, mechanicId])
  @@index([status])
}

/*
  A shop's own published price for a service. `maxPrice` is optional: a fixed
  price leaves it null, a range fills it in. These are the shop's asking
  prices and are always presented separately from what owners report paying.
*/
model ShopServicePrice {
  id         String   @id @default(cuid())
  mechanicId String
  serviceId  String
  minPrice   Float
  maxPrice   Float?
  note       String?
  updatedAt  DateTime @updatedAt

  mechanic Mechanic @relation(fields: [mechanicId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([mechanicId, serviceId])
  @@index([serviceId])
}

/*
  Every Stripe webhook we have already handled. Stripe retries on any non-2xx
  and can deliver the same event more than once, so processing is keyed on the
  event id to make replays harmless.
*/
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

/*
  "Was this helpful?" on a report. One vote per person per report, which the
  unique constraint enforces rather than trusting the client not to resubmit.
*/
model HelpfulVote {
  id           String   @id @default(cuid())
  userId       String
  experienceId String
  createdAt    DateTime @default(now())

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  experience MechanicExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@unique([userId, experienceId])
  @@index([experienceId])
}

/*
  A shop's public reply to a report about them. Only the owner of a subscribing
  shop may post one, and only one per report, so a thread cannot be buried
  under repeated responses.
*/
model ShopReply {
  id           String    @id @default(cuid())
  experienceId String    @unique
  mechanicId   String
  authorId     String
  body         String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  experience MechanicExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  mechanic   Mechanic           @relation(fields: [mechanicId], references: [id], onDelete: Cascade)
  author     User               @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([mechanicId])
}

/*
  A saved search someone wants to hear about. Alerts are generated by comparing
  new reports against these, so the query lives here rather than in a job.
*/
model SavedSearch {
  id           String    @id @default(cuid())
  userId       String
  label        String
  serviceId    String?
  generationId String?
  platformId   String?
  lat          Float?
  lng          Float?
  radiusMiles  Int?
  /// Last time this was checked, so an alert is never sent twice.
  lastNotifiedAt DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/*
  A photo of the work itself — a wrap, a brake kit, an exhaust. Deliberately
  not photos of the car: those cost storage without evidencing anything.
*/
model WorkPhoto {
  id           String   @id @default(cuid())
  experienceId String
  storageKey   String
  createdAt    DateTime @default(now())

  experience MechanicExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
}
